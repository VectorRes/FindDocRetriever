# --- Postgres / pgvector ---
POSTGRES_USER=findoc
POSTGRES_PASSWORD=findoc
POSTGRES_DB=findoc_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://findoc:findoc@postgres:5432/findoc_rag

# --- Embeddings provider ---
# openai | local
EMBEDDING_PROVIDER=openai

# Used when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Used when EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DIMENSIONS=1024

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# Max chunks returned per query
RETRIEVAL_TOP_K=8
# Min cosine similarity (0-1) for a chunk to count as relevant; 0 disables it.
# 0.25 is calibrated for text-embedding-3-small; recalibrate for other models.
RETRIEVAL_MIN_SCORE=0.25

# --- Ratios dashboard (ID-HU-FE-004) — optional, these are the defaults ---
# A ratio is an outlier when it moves more than this share of its previous value
# AND more than the minimum change for its unit (percentage points / "x").
# DASHBOARD_OUTLIER_REL_CHANGE=0.5
# DASHBOARD_OUTLIER_MIN_POINTS=0.05
# DASHBOARD_OUTLIER_MIN_TIMES=0.5
# DASHBOARD_MAX_PERIODS=8

PDF_OCR_ENABLED=true
PDF_OCR_DPI=300
PDF_OCR_LANGUAGE=eng+spa
PDF_OCR_MIN_NATIVE_CHARS=1
PDF_CHUNK_SIZE=1000
PDF_CHUNK_OVERLAP=150

# --- CORS (origins allowed to call the API, comma-separated) ---
CORS_ALLOWED_ORIGINS_RAW=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# --- Repository sync: SharePoint / Google Drive (ID-HU-INT-001, see README) ---
# Every this many minutes the API checks the connected folders; 0 = off.
SYNC_INTERVAL_MINUTES=15
# SharePoint, via an Entra ID app registration (client credentials) with the
# Microsoft Graph application permission Sites.Read.All (or Sites.Selected).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Google Drive, via a service account the folders are shared with (Viewer).
# Path to its JSON key inside the api container (e.g. mount it), or the JSON itself.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or, without service credentials: reviewers sign in with Google / Microsoft in
# the Repositories tab and pick the folders. OAuth apps (see README), with these
# redirect URIs registered:
#   http://localhost:8000/oauth/google/callback
#   http://localhost:8000/oauth/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# organizations (work/school accounts) | common (also personal) | <tenant id>
MICROSOFT_OAUTH_TENANT=common
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Encrypts the signed-in accounts' tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Langfuse: tracing of the agent for debugging (self-hosted, see README) ---
# Starts Langfuse with `docker compose up`; remove the line to run without it.
COMPOSE_PROFILES=langfuse
# Keys of the Langfuse project the API sends traces to. On Langfuse's first
# start they're created with these values. Any string with these prefixes works
# locally, e.g. pk-lf-<random hex> / sk-lf-<random hex>. Leave empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000
# Login for the Langfuse UI (http://localhost:3000), created on first start.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# Secrets of the self-hosted services; the compose file has local-only
# defaults. Generate real ones with `openssl rand -hex 32`.
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_SALT=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=

# --- Document storage (original files, for "open original file" and the PDF viewer) ---
DOCUMENT_STORAGE_DIR=/data/documents